+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+#include "SDL_internal.h"
+
+#ifdef SDL_PLATFORM_DOS
+
+#include "SDL_glos.h"
+#include <dpmi.h>
+#include <sys/nearptr.h>
+
+static struct
+{
+    unsigned long off;
+    unsigned short sel;
+} glos_entry;
+static int glos_found; // 1 GLOS, -1 none
+
+int GLOS_Call(unsigned fn, unsigned *a, unsigned *b, unsigned c, unsigned d, unsigned si)
+{
+    unsigned char failed;
+    unsigned ra = fn, rb = b ? *b : 0;
+    if (glos_found <= 0) {
+        return -1;
+    }
+    __asm__ __volatile__("lcall *%[e]\n\tsetc %[f]"
+                         : "+a"(ra), "+b"(rb), "+c"(c), "+d"(d), "+S"(si), [f] "=m"(failed)
+                         : [e] "m"(glos_entry)
+                         : "edi", "cc", "memory");
+    if (a) {
+        *a = ra;
+    }
+    if (b) {
+        *b = rb;
+    }
+    return failed ? (int)ra : 0;
+}
+
+unsigned GLOS_Caps(void)
+{
+    unsigned a, b = 0;
+    if (!glos_found) {
+        __dpmi_paddr p;
+        glos_found = -1;
+        if (__dpmi_get_vendor_specific_api_entry_point("GLOS", &p) == 0) {
+            glos_entry.off = p.offset32;
+            glos_entry.sel = p.selector;
+            glos_found = 1;
+        }
+    }
+    if (GLOS_Call(GLOS_FN_VERSION, &a, &b, 0, 0, 0) != 0 || a < 0x10001u) {
+        return 0;
+    }
+    return b;
+}
+
+bool GLOS_BecomeApp(void)
+{
+    unsigned a, b = 0x10001u; // the API version SDL is built for
+    int r;
+    if (!GLOS_Caps()) {
+        return false;
+    }
+    r = GLOS_Call(GLOS_FN_INIT, &a, &b, 0, 0, 0);
+    return r == 0 || (r == GLOS_E_INIT && b == GLOS_INIT_ALREADY);
+}
+
+void *GLOS_Pointer(unsigned linear)
+{
+    if (!linear || !__djgpp_nearptr_enable()) {
+        return NULL;
+    }
+    return (void *)(linear + __djgpp_conventional_base);
+}
+
+#endif // SDL_PLATFORM_DOS
