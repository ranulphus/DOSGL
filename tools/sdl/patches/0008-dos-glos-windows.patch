+*/
+
+// GLOS: a graphical DOS whose DPMI host answers 0A00h "GLOS" with an API of
+// windows, events and a sound mixer (GLOS's include/glos/api.h, version 1.1).
+// A program run under it gets windows instead of the screen: SDL's "glos"
+// video and audio drivers (SDL_glosvideo.c, SDL_glosaudio.c) use these.
+
+#ifndef SDL_glos_h_
+#define SDL_glos_h_
+
+#include "SDL_internal.h"
+
+#define GLOS_FN_VERSION 0
+#define GLOS_FN_INIT 1
+#define GLOS_FN_YIELD 2
+#define GLOS_FN_SLEEP 3
+#define GLOS_FN_EVENT 5
+#define GLOS_FN_WINDOW 6
+#define GLOS_FN_CLOSE 7
+#define GLOS_FN_SHOW 8
+#define GLOS_FN_RESIZE 10
+#define GLOS_FN_TITLE 11
+#define GLOS_FN_PIXELS 12
+#define GLOS_FN_PRESENT 13
+#define GLOS_FN_FOCUS 14
+#define GLOS_FN_SCREEN 15
+#define GLOS_FN_AUDIO 21
+
+#define GLOS_E_INIT 5
+#define GLOS_INIT_ALREADY 1
+
+#define GLOS_CAP_GPU 1
+#define GLOS_CAP_GLWIN 2
+#define GLOS_CAP_AUDIO 4
+
+#define GLOS_EV_KEY 1
+#define GLOS_EV_MOUSE 2
+#define GLOS_EV_FOCUS 3
+#define GLOS_EV_RESIZE 4
+#define GLOS_EV_CLOSE 5
+
+#define GLOS_WIN_FIXED 1
+#define GLOS_WIN_ANYWHERE 4
+
+typedef struct
+{
+    unsigned size, type, window, time;
+    int x, y;
+    unsigned buttons, key, ch, mods, down;
+} GLOS_Event;
+
+typedef struct
+{
+    unsigned size, id;
+    int x, y, w, h;
+    unsigned flags;
+    char title[48];
+    unsigned pixels, pitch, bpp;
+    unsigned char rpos, rsize, gpos, gsize, bpos, bsize, pad[2];
+} GLOS_Window;
+
+typedef struct
+{
+    unsigned size, rate, channels, bytes;
+    volatile unsigned write, read, periods, underruns;
+    unsigned mixer_rate, period_frames;
+    volatile unsigned volume;
+    unsigned ring;
+} GLOS_Stream;
+
+// The API's capabilities (GLOS_CAP_), 0 without GLOS 1.1 or later.
+extern unsigned GLOS_Caps(void);
+// Function fn with EBX, ECX, EDX, ESI: 0, or GLOS's error code; EAX and EBX
+// come back in *a and *b (either may be NULL).
+extern int GLOS_Call(unsigned fn, unsigned *a, unsigned *b, unsigned c, unsigned d, unsigned si);
+// The program a GLOS app (or one already): true.
+extern bool GLOS_BecomeApp(void);
+// A linear address GLOS gave, as a pointer (near pointers are on: SDL_RunApp).
+extern void *GLOS_Pointer(unsigned linear);
+
+#endif // SDL_glos_h_
