index 0ba077319..50c6a23c8 100644
--- a/src/core/dos/SDL_dos.c
+++ b/src/core/dos/SDL_dos.c
@@ -20,6 +20,9 @@
 */
 #include "SDL_internal.h"
 
+#include <signal.h>
+#include <stdlib.h>
+
 #if defined(SDL_PLATFORM_DOS)
 
 #include "SDL_dos.h"
@@ -87,6 +90,72 @@ char *DOS_GetFarPtrCString(const Uint32 segoffset)
     return retval;
 }
 
+#define DOS_MAX_CLEANUPS 4
+static DOS_CleanupFn cleanups[DOS_MAX_CLEANUPS];
+static bool cleanups_installed;
+static const int cleanup_signals[] = { SIGSEGV, SIGILL, SIGFPE, SIGABRT, SIGINT };
+#define NUM_CLEANUP_SIGNALS (int)SDL_arraysize(cleanup_signals)
+static void (*previous_handlers[NUM_CLEANUP_SIGNALS])(int);
+
+static void DOS_RunCleanups(void)
+{
+    for (int i = DOS_MAX_CLEANUPS - 1; i >= 0; i--) {
+        DOS_CleanupFn fn = cleanups[i];
+        if (fn) {
+            cleanups[i] = NULL;
+            fn();
+        }
+    }
+}
+
+static void DOS_CleanupOnSignal(int sig)
+{
+    void (*previous)(int) = SIG_DFL;
+    DOS_RunCleanups();
+    for (int i = 0; i < NUM_CLEANUP_SIGNALS; i++) {
+        if (cleanup_signals[i] == sig) {
+            previous = previous_handlers[i];
+        }
+    }
+    signal(sig, previous);
+    if (previous != SIG_DFL && previous != SIG_IGN) {
+        previous(sig);
+    } else {
+        raise(sig);
+    }
+}
+
+void DOS_AddCleanup(DOS_CleanupFn fn)
+{
+    if (!cleanups_installed) {
+        cleanups_installed = true;
+        atexit(DOS_RunCleanups);
+        for (int i = 0; i < NUM_CLEANUP_SIGNALS; i++) {
+            previous_handlers[i] = signal(cleanup_signals[i], DOS_CleanupOnSignal);
+        }
+    }
+    for (int i = 0; i < DOS_MAX_CLEANUPS; i++) {
+        if (cleanups[i] == fn) {
+            return;
+        }
+    }
+    for (int i = 0; i < DOS_MAX_CLEANUPS; i++) {
+        if (!cleanups[i]) {
+            cleanups[i] = fn;
+            return;
+        }
+    }
+}
+
+void DOS_RemoveCleanup(DOS_CleanupFn fn)
+{
+    for (int i = 0; i < DOS_MAX_CLEANUPS; i++) {
+        if (cleanups[i] == fn) {
+            cleanups[i] = NULL;
+        }
+    }
+}
+
 void DOS_HookInterrupt(int irq, DOS_InterruptHookFn fn, DOS_InterruptHook *hook)
 {
     SDL_assert(irq >= 0 && irq <= 15);
