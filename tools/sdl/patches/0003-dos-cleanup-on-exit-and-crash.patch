+// Cleanups for a program that ends without SDL_Quit(): exit() from anywhere,
+// or a fatal signal (SIGSEGV, SIGILL, SIGFPE, SIGABRT, SIGINT). Each runs at
+// most once, newest first, and must only touch hardware (no allocation): a
+// Sound Blaster left in auto-init DMA would otherwise loop its buffer until
+// the machine is reset. The signal handlers chain to those installed before
+// SDL's, and handlers installed later (a GL library's) chain to SDL's.
+typedef void (*DOS_CleanupFn)(void);
+void DOS_AddCleanup(DOS_CleanupFn fn);
+void DOS_RemoveCleanup(DOS_CleanupFn fn);
+
 // Ends C function definitions when using C++
 #ifdef __cplusplus
 }
