+// The open device, for DOS_AddCleanup: a program that exits or crashes
+// without closing it would leave the card looping its DMA buffer.
+static struct SDL_PrivateAudioData *open_device;
+
+static void DOSSOUNDBLASTER_StopOnExit(void)
+{
+    struct SDL_PrivateAudioData *hidden = open_device;
+    if (!hidden) {
+        return;
+    }
+    open_device = NULL;
+    if (hidden->is_16bit) {
+        WriteSoundBlasterDSP(0xD5); // pause 16-bit DMA
+        WriteSoundBlasterDSP(0xD9); // exit 16-bit auto-init DMA
+    } else {
+        WriteSoundBlasterDSP(0xD0); // halt 8-bit DMA
+        WriteSoundBlasterDSP(0xDA); // exit auto-init DMA
+    }
+    WriteSoundBlasterDSP(0xD3); // speaker off
+    if (hidden->is_16bit) {
+        outportb(0xD4, 0x04 | hidden->dma_channel);
+    } else {
+        outportb(0x0A, 0x04 | hidden->dma_channel);
+    }
+    DOS_UnhookInterrupt(&hidden->interrupt_hook, true);
+}
