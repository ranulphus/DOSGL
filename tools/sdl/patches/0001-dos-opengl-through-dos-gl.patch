+/* OpenGL through DOS-GL: a static OpenGL 1.1 subset for DJGPP on Matrox
+ * G200/G400/G450 cards. DOS-GL sets the video mode itself when the context
+ * is created (dglInit) and restores text mode when it is destroyed, so an
+ * OpenGL window never goes through the VESA mode set; DOS-GL's own sizes,
+ * including those it draws scaled or zoomed into a larger BIOS mode, join
+ * the display's modes (OpenGL windows only). One context at a time. */
+
+extern void DOSVESA_GL_AddDisplayModes(SDL_VideoDevice *device, SDL_VideoDisplay *display);
+extern bool DOSVESA_GL_IsGLOnlyMode(const SDL_DisplayMode *mode);
+extern SDL_DisplayMode *DOSVESA_GL_SoftwareMode(SDL_VideoDisplay *display, SDL_DisplayMode *mode);
+extern bool DOSVESA_GL_CreateWindow(SDL_VideoDevice *device, SDL_Window *window);
+extern void DOSVESA_GL_DestroyWindow(SDL_VideoDevice *device, SDL_Window *window);
+
+extern bool DOSVESA_GL_LoadLibrary(SDL_VideoDevice *device, const char *path);
+extern SDL_FunctionPointer DOSVESA_GL_GetProcAddress(SDL_VideoDevice *device, const char *proc);
+extern void DOSVESA_GL_UnloadLibrary(SDL_VideoDevice *device);
+extern SDL_GLContext DOSVESA_GL_CreateContext(SDL_VideoDevice *device, SDL_Window *window);
+extern bool DOSVESA_GL_MakeCurrent(SDL_VideoDevice *device, SDL_Window *window, SDL_GLContext context);
+extern bool DOSVESA_GL_SetSwapInterval(SDL_VideoDevice *device, int interval);
+extern bool DOSVESA_GL_GetSwapInterval(SDL_VideoDevice *device, int *interval);
+extern bool DOSVESA_GL_SwapWindow(SDL_VideoDevice *device, SDL_Window *window);
+extern bool DOSVESA_GL_DestroyContext(SDL_VideoDevice *device, SDL_GLContext context);
+
+#endif // SDL_VIDEO_OPENGL_DOSGL
+
+#endif // SDL_dosopengl_h
