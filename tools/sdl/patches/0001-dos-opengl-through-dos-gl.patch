@@ -82,6 +89,14 @@ static bool DOSVESA_CreateWindow(SDL_VideoDevice *device, SDL_Window *window, SD
         if (!mode) {
             return true;
         }
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+        // DOS-GL's own sizes are for OpenGL windows: a software window gets
+        // the nearest mode it can draw in.
+        mode = DOSVESA_GL_SoftwareMode(display, mode);
