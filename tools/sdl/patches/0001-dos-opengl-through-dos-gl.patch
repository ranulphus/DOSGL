     DOSVESA_ApplyModeForWindow(display, window, mode);
 
@@ -119,6 +142,9 @@ static void DOSVESA_GetWindowSizeInPixels(SDL_VideoDevice *device, SDL_Window *w
 
 static void DOSVESA_DestroyWindow(SDL_VideoDevice *device, SDL_Window *window)
 {
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+    DOSVESA_GL_DestroyWindow(device, window);
+#endif
     SDL_free(window->internal);
     window->internal = NULL;
 }
@@ -160,6 +186,10 @@ static bool DOSVESA_VideoInit(SDL_VideoDevice *device)
     if (!display || !DOSVESA_GetDisplayModes(device, display)) {
         return false;
     }
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+    DOSVESA_GL_AddDisplayModes(device, display);
+    data->gl_swap_interval = 1;
+#endif
 
     // Pick a sensible default desktop mode. This determines the window
     // size for FULLSCREEN_ONLY. Target 640x480 as a safe default; apps
@@ -342,6 +372,18 @@ static SDL_VideoDevice *DOSVESA_CreateDevice(void)
     device->PumpEvents = DOSVESA_PumpEvents;
     device->device_caps = VIDEO_DEVICE_CAPS_FULLSCREEN_ONLY;
 
+#ifdef SDL_VIDEO_OPENGL_DOSGL
+    device->GL_LoadLibrary = DOSVESA_GL_LoadLibrary;
+    device->GL_GetProcAddress = DOSVESA_GL_GetProcAddress;
+    device->GL_UnloadLibrary = DOSVESA_GL_UnloadLibrary;
+    device->GL_CreateContext = DOSVESA_GL_CreateContext;
+    device->GL_MakeCurrent = DOSVESA_GL_MakeCurrent;
+    device->GL_SetSwapInterval = DOSVESA_GL_SetSwapInterval;
+    device->GL_GetSwapInterval = DOSVESA_GL_GetSwapInterval;
+    device->GL_SwapWindow = DOSVESA_GL_SwapWindow;
+    device->GL_DestroyContext = DOSVESA_GL_DestroyContext;
+#endif
+
     return device;
 }
 
